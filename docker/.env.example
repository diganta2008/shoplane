# ------------------------------------------------------------------
# Copy this file to `.env` (same folder) and edit values before
# running `docker compose up`.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# Everything here maps 1:1 to the ${VAR} references in
# docker-compose.yml. Missing vars fall back to the safe defaults
# baked into the compose file (see the `environment:` block).
# ------------------------------------------------------------------

# ==================================================================
#  MySQL — credentials
# ==================================================================

# Root password — used only by admins / migrations / phpMyAdmin.
# Must NOT be blank. Change before any non-local deployment.
MYSQL_ROOT_PASSWORD=root_change_me

# Application database, created automatically on first boot.
MYSQL_DATABASE=shoplane

# Application user — receives all rights on ${MYSQL_DATABASE}.
MYSQL_USER=shoplane

# Application user's password. Change before any non-local deployment.
MYSQL_PASSWORD=shoplane_change_me

# ==================================================================
#  Host ports
# ==================================================================

# Port MySQL listens on from the host. Change if 3306 is already
# taken (e.g. by a native MySQL install).
MYSQL_PORT=3306

# Port for phpMyAdmin — only used when the `tools` compose profile
# is active:  docker compose --profile tools up -d
PMA_PORT=8081

# ==================================================================
#  Locale
# ==================================================================

# Container timezone (any IANA name — Asia/Kolkata, UTC, Europe/Berlin…)
TZ=Asia/Kolkata

# Container LANG — keep C.UTF-8 unless you have a specific reason
LANG=C.UTF-8
